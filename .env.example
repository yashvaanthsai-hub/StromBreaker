# ====================================================================
# VERITAS AP AUDIT GATEWAY - ENVIRONMENT CONFIGURATION
# ====================================================================

# --------------------------------------------------------------------
# 1. LIVE CLOUD DATABASE (Server-Only Secret)
# --------------------------------------------------------------------
# Connection string to your cloud PostgreSQL instance (Neon / Supabase / Vercel Postgres / AWS RDS)
# Example: postgresql://username:password@ep-cold-smoke-12345.us-east-2.aws.neon.tech/veritas_db?sslmode=require
DATABASE_URL=

# --------------------------------------------------------------------
# 2. MULTIMODAL AI SERVICE (Server-Only Secret)
# --------------------------------------------------------------------
# Google Gemini API key used on the backend for perceptual invoice extraction
# The browser/client bundle NEVER receives this key.
GEMINI_API_KEY=

# --------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECRET (Server-Only Secret)
# --------------------------------------------------------------------
# Cryptographic secret for signing tokens and audit authorizations
AUTH_SECRET=

# --------------------------------------------------------------------
# 4. OPTIONAL S3 / CLOUD STORAGE (Server-Only Secret)
# --------------------------------------------------------------------
# If left blank, Veritas automatically stores document binaries directly in the cloud PostgreSQL database.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# --------------------------------------------------------------------
# 5. ENVIRONMENT MODE (Server-Only)
# --------------------------------------------------------------------
ENVIRONMENT=production
